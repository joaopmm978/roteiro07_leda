<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>br.edu.ufcg.leda</groupId>
	<artifactId>submission</artifactId>
	<version>2.0</version>
	<packaging>jar</packaging>
	<name>Submissao de roteiro</name>

	<properties>
		<maven.compiler.release>25</maven.compiler.release>
	</properties>

	<pluginRepositories>
		<pluginRepository>
			<id>ufcg-leda</id>
			<url>http://leda.computacao.ufcg.edu.br:8081/repository/ufcg-leda/</url>
			<layout>default</layout>
			<snapshots>
				<enabled>true</enabled>
				<updatePolicy>always</updatePolicy>
			</snapshots>
		</pluginRepository>
	</pluginRepositories>

	<dependencies>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>1.18.46</version>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>6.1.3</version>
		</dependency>
	</dependencies>
	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.6</version>
				<configuration>
                <includes>
                    <include>**/*Test*.java</include>
                </includes>
            </configuration>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.15.0</version>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>1.18.46</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-clean-plugin</artifactId>
				<version>3.5.0</version>
				<executions>
					<execution>
						<id>auto-clean</id>
						<phase>build</phase>
						<goals>
							<goal>clean</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>br.edu.ufcg.leda</groupId>
				<artifactId>leda-compactor-tool</artifactId>
				<version>2.0.0-SNAPSHOT</version>
				<executions>
					<execution>
						<phase>install</phase>
						<goals>
							<goal>compact</goal>
						</goals>
						<configuration>
							<!-- insira sua matricula -->
							<matricula>20250018950</matricula>
							<!-- insira o ID correto da atividade e a turma -->
							<roteiro>R07-01</roteiro>
							<!-- NÃO MODIFIQUE AS TAGS ABAIXO -->
							<urlSemesters>http://leda.computacao.ufcg.edu.br:81/api/geral/getSemesters</urlSemesters>
							<urlSubmit>http://leda.computacao.ufcg.edu.br:81/api/submissoes/saveSubmission</urlSubmit>
							<urlGetAllStudents>http://leda.computacao.ufcg.edu.br:81/api/alunos/allStudentsGroupedByClass</urlGetAllStudents>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>